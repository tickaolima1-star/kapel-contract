# ==========================================
# VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO (VERCEL)
# ==========================================

# 1. Conexão com o Banco de Dados Supabase (PostgreSQL)
# Use o connection string Transaction Pooler (porta 6543) para Next.js Serverless
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use o direct URL (porta 5432) para migrations do Prisma
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Chave de sessão obrigatória, aleatória e com no mínimo 32 caracteres
JWT_SECRET=""

# 2. URLs da Aplicação
NEXT_PUBLIC_APP_URL="https://contratos.kapel.digital"

# 3. Dados Oficiais da Empresa (KAPEL)
NEXT_PUBLIC_COMPANY_NAME="KAPEL"
NEXT_PUBLIC_COMPANY_LEGAL_NAME="67.726.428 PATRICK EDUARDO LIMA SILVA"
NEXT_PUBLIC_COMPANY_CNPJ="67.726.428/0001-97"

# 4. Chaves do Projeto Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_SECRET_KEY]"
